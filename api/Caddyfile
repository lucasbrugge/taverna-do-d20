{
	frankenphp
	auto_https off
}

:80 {
	root * /app/public
	encode zstd gzip

	# Documentação pública: caminhos físicos de public, sem passar pelo Laravel.
	@docs path /api/docs /api/docs/*
	handle @docs {
		header /api/docs/openapi.yaml Content-Type "application/yaml; charset=utf-8"
		file_server {
			index index.html
			disable_canonical_uris
		}
	}

	handle {
		php_server
	}
}
